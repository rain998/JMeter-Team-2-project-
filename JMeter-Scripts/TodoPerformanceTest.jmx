              <stringProp name="script">vars.put(&quot;deleting&quot;, &quot;false&quot;)
if ((new Random().nextInt(100) + 1) &lt;= 30) {
	vars.put(&quot;deleting&quot;, &quot;true&quot;)
} else {
	vars.put(&quot;deleting&quot;, &quot;false&quot;)
}
</stringProp>
